<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>bundle</id>
  <formats><format>zip</format></formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <files>
    <file>
      <source>${project.build.directory}/${project.build.finalName}.jar</source>
      <outputDirectory>/</outputDirectory>
    </file>
  </files>
  <fileSets>
    <!-- 菜单依赖直接取自插件资源，保持 JAR 与附带配置一致。 -->
    <fileSet>
      <directory>${project.basedir}/src/main/resources</directory>
      <outputDirectory>menu-configs/FutureUI</outputDirectory>
      <includes>
        <include>menus/basictool/**/*.yml</include>
        <include>templates/integrations/basictool/**/*.yml</include>
        <include>languages/*/integrations/basictool*.yml</include>
        <include>menus/fotiacosmetic/*.yml</include>
        <include>templates/integrations/fotiacosmetic/*.yml</include>
        <include>languages/*/integrations/fotiacosmetic*.yml</include>
        <include>menus/fotiachat/*.yml</include>
        <include>templates/integrations/fotiachat/*.yml</include>
        <include>languages/*/integrations/fotiachat.yml</include>
        <include>menus/fotiacrates/*.yml</include>
        <include>menus/fotiatags/*.yml</include>
        <include>templates/integrations/fotiatags/*.yml</include>
        <include>languages/*/integrations/fotiatags.yml</include>
        <include>templates/integrations/fotiacrates/*.yml</include>
        <include>languages/*/integrations/fotiacrates.yml</include>
        <include>assets/images/fotiacrates.yml</include>
        <include>assets/images/basictool.yml</include>
        <include>assets/images/fotiatags.yml</include>
        <include>assets/viewports.yml</include>
        <include>assets/themes/adventure.yml</include>
        <include>assets/themes/basictool-settings.yml</include>
      </includes>
    </fileSet>
    <!-- 仅保存接管配置；测试模型、玩家数据和运行目录不得进入发布包。 -->
    <fileSet>
      <directory>${project.basedir}/distribution/fotiacosmetic</directory>
      <outputDirectory>menu-configs/FotiaCosmetic</outputDirectory>
      <includes>
        <include>menus/*.yml</include>
        <include>languages/*.yml</include>
        <include>futureui-preview.yml</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/distribution/fotiachat</directory>
      <outputDirectory>menu-configs/FotiaChat</outputDirectory>
      <includes>
        <include>menus/*.yml</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/distribution/fotiacrates</directory>
      <outputDirectory>menu-configs/FotiaCrates</outputDirectory>
      <includes><include>futureui.yml</include></includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/distribution/fotiatags</directory>
      <outputDirectory>menu-configs/FotiaTags</outputDirectory>
      <includes><include>menus/*.yml</include><include>futureui.yml</include></includes>
    </fileSet>
  </fileSets>
</assembly>
